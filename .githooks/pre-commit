#!/usr/bin/env bash
#
# Pre-commit: офлайн-проверки репозитория на каждом коммите.
#
# Активация (один раз на машину):
#   git config core.hooksPath .githooks
#
# В хук входит только то, что детерминировано и не зависит от сети:
# коммит не должен падать из-за недоступности инстанса. Сетевая
# сверка инстанса с репозиторием — tools/check-migrations.py (GET,
# ключ платформы); она обязательна после каждого изменения через MCP,
# на ревью (REVIEW-CHECKLIST п. 2) и на приёмке (BACKLOG W15, п. 0).
#
# set -e не используется: нужно прогнать все проверки, а не первую.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

flows_changed="$(grep -c '^flows/.*\.json$' <<<"$staged")" || flows_changed=0
i18n_changed="$(grep -c '^i18n/ru\.json$' <<<"$staged")" || i18n_changed=0
agents_changed="$(grep -cE '^(AGENTS\.md|CLAUDE\.md|opencode\.json|\.mcp\.json|docs/agents/|\.opencode/agent/|\.claude/agents/|tools/check-agents\.py)' <<<"$staged")" || agents_changed=0
prototypes_changed="$(grep -cE '^prototypes/.*\.js$' <<<"$staged")" || prototypes_changed=0

if [[ "$flows_changed" -eq 0 && "$i18n_changed" -eq 0 && "$agents_changed" -eq 0 && "$prototypes_changed" -eq 0 ]]; then
  exit 0
fi

status=0

if [[ "$flows_changed" -ne 0 || "$i18n_changed" -ne 0 ]]; then
  echo "pre-commit: изменились flows/i18n — экспортные проверки"
  tools/check-export-secrets.sh || status=1
  tools/check-texts.py i18n/ru.json flows/*.json || status=1
  tools/check-commands.py i18n/*.json flows/*.json || status=1
fi

if [[ "$agents_changed" -ne 0 ]]; then
  echo "pre-commit: изменились роли агентов или их конфиги — проверка согласованности"
  python3 tools/check-agents.py || status=1
fi

if [[ "$prototypes_changed" -ne 0 ]]; then
  echo "pre-commit: изменились prototypes/*.js — синтаксис и сценарии (W118)"
  if command -v node >/dev/null 2>&1; then
    node prototypes/check.mjs || status=1
  else
    echo "  node не найден — проверка пропущена (выполнит CI)"
  fi
fi

if [[ "$status" -ne 0 ]]; then
  echo "pre-commit: КОММИТ ЗАБЛОКИРОВАН (обходить --no-verify нельзя:"
  echo "секрет, расхождение текстов, чужая команда, битый прототип или разъехавшиеся роли"
  echo "уедут в историю git навсегда)"
fi
exit "$status"
