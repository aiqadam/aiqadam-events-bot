                      "sourceCode": {
                        "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const eventId = String(inputs.eventId === undefined || inputs.eventId === null ? '' : inputs.eventId);\n  const rows = arr(inputs.eventRecords).map(flat);\n  const ev = rows.find((r) => String(r.id || '') === eventId);\n  if (!ev) return { text: t('cancel.not_found') };\n  const title = ev.title || eventId;\n  return {\n    text: t('cancel.confirm', { title: title }),\n    reply_markup: { inline_keyboard: [[\n      { text: t('cancel.btn.confirm'), callback_data: 'myreg:yes:' + eventId },\n      { text: t('cancel.btn.keep'), callback_data: 'myreg:no' }\n    ]] }\n  };\n};",
                        "packageJson": "{}"
