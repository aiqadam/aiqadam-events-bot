                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const eventId = String(inputs.eventId === undefined || inputs.eventId === null ? '' : inputs.eventId);\n  const telegramId = String(inputs.telegramId === undefined || inputs.telegramId === null ? '' : inputs.telegramId);\n  const ev = arr(inputs.eventRecords).map(flat).find((r) => String(r.id || '') === eventId);\n  const regs = arr(inputs.regRecords).map(flat).filter((r) => String(r.event_id || '') === eventId && String(r.telegram_id || '') === telegramId);\n  const myActive = regs.find((r) => String(r.status || '') === 'registered');\n  if (!ev || !myActive) {\n    const title = ev ? (ev.title || '') : '';\n    return { outcome: 'not_found', title: title, text: t('cancel.not_found') };\n  }\n  const startMs = parseIso(ev.starts_at || '');\n  if (isFinite(startMs) && Date.now() >= startMs) {\n    return { outcome: 'too_late', title: ev.title || '', text: t('cancel.too_late') };\n  }\n  return { outcome: 'ok', title: ev.title || '', text: t('cancel.done', { title: ev.title || '' }), now: new Date().toISOString(), regId: eventId + '-' + telegramId };\n};",
                          "packageJson": "{}"
