            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const cb = String(inputs.callbackData === undefined || inputs.callbackData === null ? '' : inputs.callbackData);\n  let action = 'unknown';\n  let eventId = '';\n  let m = cb.match(/^myreg:cancel:([A-Za-z0-9_-]{1,64})$/);\n  if (m) { action = 'confirm'; eventId = m[1]; }\n  else if ((m = cb.match(/^myreg:yes:([A-Za-z0-9_-]{1,64})$/))) { action = 'do_yes'; eventId = m[1]; }\n  else if (cb === 'myreg:no') { action = 'keep'; }\n  return { action: action, eventId: eventId };\n};",
