                      "sourceCode": {
                        "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const dateFmt = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Asia/Tashkent', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n  const fmt = (iso) => {\n    const ms = parseIso(iso);\n    return isFinite(ms) ? dateFmt.format(new Date(ms)) : '';\n  };\n\n  const telegramId = str(inputs.telegramId);\n  const action = str(inputs.action);\n  const eventId = str(inputs.eventId);\n  const consentPdn = inputs.consentPdn === true || str(inputs.consentPdn) === 'true';\n  const consentMarketing = inputs.consentMarketing === true || str(inputs.consentMarketing) === 'true';\n  const now = str(inputs.now);\n\n  // Постфильтры повторяют фильтры шагов — defense in depth (Q25).\n  const myRegs = arr(inputs.myRegs).map(flat).filter((r) => str(r.telegram_id) === telegramId);\n  const eventRegs = arr(inputs.eventRegs).map(flat).filter((r) => str(r.event_id) === eventId);\n  const ev = arr(inputs.eventRecords).map(flat).find((r) => str(r.id) === eventId);\n  const title = ev ? str(ev.title) : '';\n\n  const base = { ok: false, outcome: '', error: '', reason: '', text: '', eventId: eventId, mine: [], regId: '', consentValue: 'false', httpStatus: 200 };\n\n  if (action === 'mine') {\n    // «Мои билеты»: только регистрации вызывающего, только живые (W43, PAR-4).\n    const mine = myRegs\n      .filter((r) => str(r.status) === 'registered' || str(r.status) === 'checked_in')\n      .map((r) => ({\n        eventId: str(r.event_id),\n        status: str(r.status),\n        registeredAt: str(r.registered_at),\n        checkedInAt: str(r.checked_in_at)\n      }));\n    return Object.assign(base, { httpStatus: 200, ok: true, outcome: 'mine', mine: mine });\n  }\n\n  if (action === 'register') {\n    if (!consentPdn) {\n      return Object.assign(base, { httpStatus: 400, error: 'pdn_required', text: t('reg.err.pdn_required') });\n    }\n    if (eventId === '') {\n      return Object.assign(base, { httpStatus: 400, error: 'bad_request', text: t('reg.err.bad_request') });\n    }\n    const mineRow = eventRegs.find((r) => str(r.telegram_id) === telegramId);\n    const mineStatus = mineRow ? str(mineRow.status) : '';\n    if (mineStatus === 'registered' || mineStatus === 'checked_in') {\n      // IDM-1: повтор — та же регистрация, второго подтверждения нет.\n      return Object.assign(base, { httpStatus: 200, ok: true, outcome: 'existing', text: t('reg.already', { title: title }) });\n    }\n    if (!ev) {\n      return Object.assign(base, { httpStatus: 404, error: 'not_found', reason: 'event_not_found', text: t('common.err.event_not_found') });\n    }\n    const evStatus = str(ev.status);\n    if (evStatus === 'cancelled') {\n      return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'event_cancelled', text: t('reg.event_cancelled') });\n    }\n    if (evStatus === 'finished') {\n      return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'event_finished', text: t('reg.event_finished') });\n    }\n    if (evStatus !== 'published') {\n      return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'not_published', text: t('reg.not_published') });\n    }\n    const deadlineIso = str(ev.reg_deadline_at);\n    const deadlineMs = deadlineIso ? parseIso(deadlineIso) : NaN;\n    if (isFinite(deadlineMs) && Date.now() > deadlineMs) {\n      return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'deadline_passed', text: t('reg.deadline_passed', { when: fmt(deadlineIso) }) });\n    }\n    // Лимит мест — capacity × (1 + overbook_pct/100), округление вверх; пустой overbook_pct = 40 (OWN-15).\n    const capacityRaw = str(ev.capacity);\n    const capacity = capacityRaw === '' ? NaN : Number(capacityRaw);\n    const overbookRaw = str(ev.overbook_pct);\n    const overbook = (overbookRaw === '' || !isFinite(Number(overbookRaw))) ? 40 : Number(overbookRaw);\n    const registeredCount = eventRegs.filter((r) => str(r.status) === 'registered').length;\n    if (isFinite(capacity)) {\n      const limit = Math.ceil(capacity * (1 + overbook / 100));\n      if (registeredCount >= limit) {\n        return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'no_seats', text: t('reg.no_seats') });\n      }\n    }\n    return Object.assign(base, {\n      httpStatus: 200, ok: true, outcome: 'registered',\n      text: t('reg.done', { title: title }),\n      regId: eventId + '-' + telegramId,\n      consentValue: consentMarketing ? 'true' : 'false'\n    });\n  }\n\n  if (action === 'cancel') {\n    if (eventId === '') {\n      return Object.assign(base, { httpStatus: 400, error: 'bad_request', text: t('reg.err.bad_request') });\n    }\n    const active = eventRegs.find((r) => str(r.telegram_id) === telegramId && str(r.status) === 'registered');\n    if (!ev || !active) {\n      return Object.assign(base, { httpStatus: 404, error: 'not_found', reason: 'not_registered', text: t('cancel.not_found') });\n    }\n    // PAR-5: сервер перепроверяет срок — опоздавший запрос получает отказ, а не отмену.\n    const startMs = parseIso(str(ev.starts_at));\n    if (isFinite(startMs) && Date.now() >= startMs) {\n      return Object.assign(base, { httpStatus: 409, error: 'declined', reason: 'too_late', text: t('cancel.too_late') });\n    }\n    return Object.assign(base, { httpStatus: 200, ok: true, outcome: 'cancelled', text: t('cancel.done', { title: title }) });\n  }\n\n  return Object.assign(base, { httpStatus: 400, error: 'bad_request', text: t('reg.err.bad_request') });\n};\n",
                        "packageJson": "{}"
                      }
