            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const hasPhoto = inputs.hasPhoto === true || inputs.hasPhoto === 'true';\n  const text = String(inputs.text === undefined || inputs.text === null ? '' : inputs.text).trim();\n  const scenario = String(inputs.sessionScenario === undefined || inputs.sessionScenario === null ? '' : inputs.sessionScenario);\n  let draft = {};\n  try { draft = JSON.parse(String(inputs.sessionDraft === undefined || inputs.sessionDraft === null ? '{}' : inputs.sessionDraft)); } catch (e) { draft = {}; }\n\n  const ok = hasPhoto || text === '-';\n  if (ok) {\n    draft.photo_file_id = hasPhoto ? String(inputs.photoFileId || '') : '';\n  }\n\n  return {\n    ok: ok, scenario: scenario,\n    draft: JSON.stringify(draft),\n    now: new Date().toISOString()\n  };\n};",
