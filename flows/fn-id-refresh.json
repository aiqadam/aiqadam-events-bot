            "sourceCode": {
              "code": "// fn-id-refresh outcome (ADR-0060 §5). Logged on purpose: ok, the HTTP status, a reason code and written only.\nexport const code = async (inputs) => {\n  const status = Number.isInteger(inputs.status) ? inputs.status : 0;\n  const reason = typeof inputs.reason === 'string' && /^[a-z0-9_]{1,20}$/.test(inputs.reason) ? inputs.reason : 'other';\n  return { ok: inputs.ok === true, status, reason, written: inputs.written === true };\n};",
