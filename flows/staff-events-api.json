            "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const telegramId = str(inputs.telegramId).trim();\n  // W102: tables-find-records fail-closed на пустом eq. Невалидный initData\n  // даёт telegramId '', фильтр step_2 получает sentinel и возвращает пусто\n  // (как раньше), а не валит прогон.\n  return { telegramIdOrNone: telegramId !== '' ? telegramId : '__none__' };\n};",
