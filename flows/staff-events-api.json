                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  // W50 (вердикт W49): какие события контролёру показывать кнопку сканера —\n  // решает сервер, страница только рисует. Активная строка event_staff\n  // (пустой revoked_at) на ещё не закончившееся опубликованное событие.\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = str(c.value);\n      else out[fid] = str(c);\n    });\n    return out;\n  };\n  const hmac = inputs.hmac || {};\n  if (str(hmac.valid) !== 'true') {\n    return { httpStatus: 401, ok: false, error: 'invalid_init_data', eventIds: [] };\n  }\n  const me = str(hmac.telegramId);\n  const nowMs = Date.now();\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const byId = {};\n  arr(inputs.events).map(flat).forEach((r) => { if (r.status === 'published') byId[r.id] = r; });\n  const notPast = (r) => {\n    const endMs = parseIso(r.ends_at || r.starts_at || '');\n    return isFinite(endMs) ? endMs > nowMs : true;\n  };\n  const ids = arr(inputs.staff).map(flat)\n    .filter((r) => r.telegram_id === me && r.revoked_at === '' && byId[r.event_id] && notPast(byId[r.event_id]))\n    .map((r) => r.event_id);\n  return { httpStatus: 200, ok: true, error: '', eventIds: [...new Set(ids)] };\n};",
                  "packageJson": "{}"
                }
              },
