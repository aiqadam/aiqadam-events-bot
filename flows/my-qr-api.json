                    },
                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n\n  const hmac = inputs.hmac || {};\n  const telegramId = String(hmac.telegramId || '');\n\n  const reg = inputs.reg || {};\n  const found = reg.found === true || reg.found === 'true';\n  const registered = reg.registered === true || reg.registered === 'true';\n\n  const sign = inputs.sign || {};\n\n  // W67 (ADR-0051): событие читает step_9. Непустой online_url = онлайн-событие:\n  // QR не выдаём вовсе — вместо подписи отдаём ссылку трансляции.\n  const evRows = Array.isArray(inputs.event) ? inputs.event\n    : (inputs.event && Array.isArray(inputs.event.records) ? inputs.event.records : []);\n  const hasEvent = evRows.length > 0;\n  const first = evRows[0] || null;\n  const cells = (first && first.cells && typeof first.cells === 'object') ? first.cells : {};\n  let onlineUrl = '';\n  Object.keys(cells).forEach((fid) => {\n    const c = cells[fid];\n    if (c && typeof c === 'object' && c.fieldName === 'online_url') onlineUrl = c.value === undefined || c.value === null ? '' : String(c.value);\n  });\n\n  let httpStatus = 200;\n  let ok = false;\n  let error = '';\n  let text = '';\n  let payload = '';\n  let online = false;\n  let url = '';\n\n  if (!found || !registered) {\n    error = 'not_registered'; text = t('checkin.not_registered');\n  } else if (onlineUrl !== '') {\n    ok = true; online = true; url = onlineUrl;\n  } else if (!hasEvent) {\n    // step_9 с continueOnFailure: при сбое чтения события не откатываемся молча\n    // в QR (иначе онлайн-событие тайком показало бы подпись) — честная ошибка.\n    httpStatus = 500; error = 'server_error'; text = '';\n  } else {\n    ok = true; payload = String(sign.payload || '');\n  }\n\n  return {\n    httpStatus: httpStatus, ok: ok, error: error, text: text, payload: payload,\n    online: online, url: url,\n    eventId: String(inputs.eventId || ''), userId: telegramId\n  };\n};\n",
                      "packageJson": "{}"
                    }
