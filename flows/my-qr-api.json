                    "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n\n  const hmac = inputs.hmac || {};\n  const telegramId = String(hmac.telegramId || '');\n\n  const reg = inputs.reg || {};\n  const found = reg.found === true || reg.found === 'true';\n  const registered = reg.registered === true || reg.registered === 'true';\n\n  const sign = inputs.sign || {};\n\n  let httpStatus = 200;\n  let ok = false;\n  let error = '';\n  let text = '';\n  let payload = '';\n\n  if (!found || !registered) {\n    error = 'not_registered'; text = t('checkin.not_registered');\n  } else {\n    ok = true; payload = String(sign.payload || '');\n  }\n\n  return {\n    httpStatus: httpStatus, ok: ok, error: error, text: text, payload: payload,\n    eventId: String(inputs.eventId || ''), userId: telegramId\n  };\n};",
