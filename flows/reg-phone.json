        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const num = (v) => { const n = Number(v); return isFinite(n) && n > 0 ? n : 0; };\n\n  // DAT-2: телефон сохраняется только из request_contact и только свой,\n  // не пересланный чужой контакт.\n  const isContact = str(inputs.kind) === 'contact';\n  const isOwn = inputs.contactIsOwn === true || inputs.contactIsOwn === 'true';\n  const hasContact = isContact && isOwn;\n  const phoneToSave = hasContact ? str(inputs.contactPhone) : '';\n\n  let draft = {};\n  try { draft = JSON.parse(str(inputs.sessionDraft) || '{}'); } catch (e) { draft = {}; }\n\n  return {\n    hasContact: hasContact,\n    phoneToSave: phoneToSave,\n    eventId: str(draft.eventId) || str(inputs.eventId),\n    cardMessageId: num(draft.cardMessageId),\n    promptMessageId: num(draft.promptMessageId),\n    userMessageId: num(inputs.userMessageId),\n    now: new Date().toISOString()\n  };\n};",
