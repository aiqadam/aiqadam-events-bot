            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (k) => String(texts[k] === undefined || texts[k] === null ? k : texts[k]);\n  const hmac = (inputs.hmac && typeof inputs.hmac === 'object') ? inputs.hmac : {};\n  const valid = hmac.valid === true || hmac.valid === 'true';\n  const telegramId = String(hmac.telegramId === undefined || hmac.telegramId === null ? '' : hmac.telegramId).trim();\n  if (!valid || !telegramId) {\n    return { authorized: false, httpStatus: 401, ok: false, error: 'invalid_init_data', text: t('checkin.unauthorized'), fields: {}, eventId: '', telegramId: '' };\n  }\n  return { authorized: true, httpStatus: 200, ok: true, error: '', text: '', fields: {}, eventId: '', telegramId: telegramId };\n};\n",
