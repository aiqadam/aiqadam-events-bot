                      "sourceCode": {
                        "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (k) => String(texts[k] === undefined || texts[k] === null ? k : texts[k]);\n  const str = (v) => String(v === undefined || v === null ? '' : v).trim();\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const match = (rows, key, val) => arr(rows).map(flat).filter((r) => str(r[key]) === val)[0] || null;\n\n  const telegramId = str(inputs.telegramId);\n  const reqEventId = str(inputs.eventId);\n  const forbidden = {\n    outcome: 'error', httpStatus: 403, ok: false, error: 'forbidden', text: t('manage.err.forbidden'),\n    fields: {}, eventId: reqEventId, chapterId: '', title: '', telegramId: telegramId\n  };\n\n  // Права: строка `staff` вызывающего + чаптер события (ADR-0024), fail-closed.\n  const staffRow = match(inputs.staff, 'telegram_id', telegramId);\n  if (!telegramId || !staffRow) return forbidden;\n  const staffChapter = str(staffRow.chapter_id);\n\n  // Сентинел '-' (не-slug) — не ключ, отказ до любого сравнения.\n  if (reqEventId === '-' || reqEventId === '') return forbidden;\n\n  const ev = match(inputs.events, 'id', reqEventId);\n  if (!ev || str(ev.id) !== reqEventId) return forbidden;\n  const chapterId = str(ev.chapter_id);\n  if (!(staffChapter === '' || staffChapter === chapterId)) return forbidden;\n\n  return {\n    outcome: 'ok', httpStatus: 200, ok: true, error: '', text: '', fields: {},\n    eventId: reqEventId, chapterId: chapterId, title: str(ev.title), telegramId: telegramId\n  };\n};\n",
                        "packageJson": "{}"
