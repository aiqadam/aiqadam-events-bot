        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const body = (inputs.body && typeof inputs.body === 'object') ? inputs.body : {};\n  const initData = String(body.initData === undefined || body.initData === null ? '' : body.initData).trim();\n  const raw = String(body.eventId === undefined || body.eventId === null ? '' : body.eventId).trim();\n  const SLUG = /^[A-Za-z0-9_]{1,12}$/;\n  const eventId = SLUG.test(raw) ? raw : '-';\n  return { initData: initData, eventId: eventId };\n};\n",
