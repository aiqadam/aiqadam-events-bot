                              "sourceCode": {
                                "code": "export const code = async (inputs) => {\n  const TZ = 'Asia/Tashkent';\n  const timeFmt = new Intl.DateTimeFormat('ru-RU', { timeZone: TZ, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] || key);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n\n  const hmac = inputs.hmac || {};\n  const controllerTelegramId = String(hmac.telegramId || '');\n\n  const staffRows = Array.isArray(inputs.staffRows) ? inputs.staffRows : [];\n  const isStaff = staffRows.length > 0;\n\n  const parsed = inputs.parsed || {};\n  const parsedValid = (parsed.valid === true || parsed.valid === 'true') && String(parsed.kind || '') === 'c';\n\n  const qr = inputs.qr || {};\n  const qrValid = qr.valid === true || qr.valid === 'true';\n\n  const requestedEventId = String(inputs.requestedEventId || '');\n  const qrEventId = String(parsed.eventId || '');\n\n  const reg = inputs.reg || {};\n  const found = reg.found === true || reg.found === 'true';\n  const registered = reg.registered === true || reg.registered === 'true';\n  const checkedIn = reg.checkedIn === true || reg.checkedIn === 'true';\n  const checkedInAt = String(reg.checkedInAt || '');\n\n  const nameRows = Array.isArray(inputs.nameRows) ? inputs.nameRows : [];\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const nameRow = nameRows.length > 0 ? flat(nameRows[0]) : {};\n  const name = nameRow.first_name || t('checkin.name_unknown');\n\n  // Статус события (step_13): чекин отменённого события не проходит.\n  const eventRows = Array.isArray(inputs.eventRows) ? inputs.eventRows : [];\n  const eventRow = eventRows.length > 0 ? flat(eventRows[0]) : {};\n  const eventCancelled = String(eventRow.status || '') === 'cancelled';\n\n  const fmtTime = (iso) => {\n    if (!iso) return '';\n    const s = /[Zz]$/.test(iso) || /[+-][0-9]{2}:?[0-9]{2}$/.test(iso) ? iso : iso + 'Z';\n    const d = new Date(s);\n    return isNaN(d.getTime()) ? '' : timeFmt.format(d);\n  };\n\n  let httpStatus = 200;\n  let status = '';\n  let text = '';\n  let shouldCheckin = false;\n\n  if (!isStaff) {\n    httpStatus = 403; status = 'forbidden'; text = t('checkin.forbidden');\n  } else if (!parsedValid) {\n    status = 'invalid'; text = t('checkin.invalid');\n  } else if (qrEventId !== requestedEventId) {\n    status = 'wrong_event'; text = t('checkin.wrong_event');\n  } else if (!qrValid) {\n    status = 'invalid'; text = t('checkin.invalid');\n  } else if (eventCancelled) {\n    status = 'event_cancelled'; text = t('checkin.event_cancelled');\n  } else if (!found || !registered) {\n    status = 'not_registered'; text = t('checkin.not_registered');\n  } else if (checkedIn) {\n    status = 'already'; text = t('checkin.already', { time: fmtTime(checkedInAt) });\n  } else {\n    status = 'ok'; text = t('checkin.ok', { name: name }); shouldCheckin = true;\n  }\n\n  return {\n    httpStatus: httpStatus, status: status, text: text, name: name,\n    shouldCheckin: shouldCheckin,\n    writeRecordId: shouldCheckin ? String(reg.recordId || '-') : '-',\n    controllerTelegramId: controllerTelegramId,\n    now: new Date().toISOString()\n  };\n};\n",
                                "packageJson": "{}"
                              }
