          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const reg = arr(inputs.registration).map(flat)[0] || {};\n  // Доказательство присутствия — непустой checked_in_at. Статус `registered`\n  // означает «записался», а не «пришёл».\n  const v = str(reg.checked_in_at);\n  return { attended: v !== '' && v !== '-', now: new Date().toISOString() };\n};",
