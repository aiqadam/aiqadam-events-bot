                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n  // Эталон экранирования MarkdownV2 — catalog/snippets/markdown-v2.md.\n  const esc = (v) => String(v === undefined || v === null ? '' : v)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/([_*\\[\\]()~`>#+\\-=|{}.!])/g, '\\\\$1');\n\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const TZ = 'Asia/Tashkent';\n  const dateFmt = new Intl.DateTimeFormat('ru-RU', { timeZone: TZ, day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n  const parse = (iso) => {\n    if (!iso) return NaN;\n    const s = /[Zz]$/.test(iso) || /[+-][0-9]{2}:?[0-9]{2}$/.test(iso) ? iso : iso + 'Z';\n    return Date.parse(s);\n  };\n\n  const thisEventId = str(inputs.eventId);\n  const now = Date.now();\n  // Сортировки у tables-find-records нет — ближайший выбирается здесь.\n  const upcoming = arr(inputs.events).map(flat)\n    .filter((e) => str(e.id) !== thisEventId)\n    .filter((e) => str(e.cancelled_at) === '' && str(e.finished_at) === '')\n    .map((e) => ({ e: e, ts: parse(e.starts_at) }))\n    .filter((x) => isFinite(x.ts) && x.ts > now)\n    .sort((a, b) => a.ts - b.ts);\n  const next = upcoming.length ? upcoming[0] : null;\n\n  const lines = [esc(t('afterword.thanks'))];\n  const buttons = [];\n  if (next) {\n    lines.push(esc(t('afterword.next_header')));\n    const card = ['*' + esc(str(next.e.title)) + '*', '📅 ' + esc(dateFmt.format(new Date(next.ts)))];\n    if (str(next.e.address)) card.push('📍 ' + esc(str(next.e.address)));\n    lines.push(card.join('\\n'));\n    buttons.push([{ text: t('afterword.btn_next'), url: 'https://t.me/' + str(inputs.botUsername) + '?start=e' + str(next.e.id) + '-afterword' }]);\n  } else {\n    lines.push(esc(t('afterword.no_next')));\n  }\n\n  return {\n    hasNext: !!next,\n    nextEventId: next ? str(next.e.id) : '',\n    text: lines.join('\\n\\n'),\n    replyMarkup: buttons.length ? { inline_keyboard: buttons } : null,\n    now: new Date().toISOString()\n  };\n};",
