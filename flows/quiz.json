          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = str(c.value);\n      else out[fid] = str(c);\n    });\n    return out;\n  };\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const now = Date.now();\n  const quizzes = arr(inputs.records).map(flat);\n  const active = quizzes.filter((q) => {\n    const st = parseIso(str(q.starts_at));\n    const en = parseIso(str(q.ends_at));\n    return isFinite(st) && isFinite(en) && now >= st && now <= en;\n  }).sort((a, b) => parseIso(str(b.starts_at)) - parseIso(str(a.starts_at)));\n  const q = active[0] || null;\n  const quizId = q ? str(q.id) : '';\n  return {\n    active: !!q,\n    quizId: quizId,\n    quizIdOrNone: quizId || '__none__',\n    title: q ? str(q.title) : '',\n    nowIso: new Date(now).toISOString(),\n    nowMs: now\n  };\n};",
            "packageJson": "{}"
