                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = str(c.value);\n      else out[fid] = str(c);\n    });\n    return out;\n  };\n  const now = Date.now();\n  const nowIso = new Date(now).toISOString();\n  const quizId = str(inputs.quizId);\n  const active = inputs.active === true || str(inputs.active) === 'true';\n  const title = str(inputs.title);\n  const questions = arr(inputs.questions).map(flat)\n    .filter((q) => str(q.quiz_id) === quizId)\n    .sort((a, b) => Number(a.idx) - Number(b.idx));\n  const attempts = arr(inputs.attempts).map(flat);\n  const attempt = attempts[0] || null;\n  const finished = !!attempt && str(attempt.finished_at) !== '';\n  const count = questions.length;\n  const out = { outcome: 'reply', text: '', quizId: quizId, count: count, nowIso: nowIso, nowMs: now, draft: '' };\n  if (!active || count === 0) {\n    out.text = t('quiz.closed');\n    return out;\n  }\n  if (finished) {\n    out.text = t('quiz.already');\n    return out;\n  }\n  const q1 = str(questions[0].text);\n  out.outcome = 'start';\n  out.text = t('quiz.intro', { title: title, total: count }) + '\\n\\n'\n    + t('quiz.q_header', { n: 1, total: count }) + '\\n\\n'\n    + q1 + '\\n\\n' + t('quiz.q_hint');\n  out.draft = JSON.stringify({ quizId: quizId, idx: 1, count: count, shownAt: now });\n  return out;\n};",
