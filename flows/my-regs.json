                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const TZ = 'Asia/Tashkent';\n  const dateFmt = new Intl.DateTimeFormat('ru-RU', { timeZone: TZ, day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n  const fmt = (iso) => {\n    if (!iso) return '';\n    const ms = parseIso(iso);\n    return isFinite(ms) ? dateFmt.format(new Date(ms)) : '';\n  };\n  const miniappUrl = String(inputs.miniappUrl === undefined || inputs.miniappUrl === null ? '' : inputs.miniappUrl);\n  const nowMs = Date.now();\n  const eventsById = {};\n  arr(inputs.eventRecords).map(flat).forEach((r) => {\n    if (String(r.status || '') === 'published' && r.id) eventsById[r.id] = r;\n  });\n  const regMs = (s) => {\n    const v = parseIso(String(s || ''));\n    return isFinite(v) ? v : Infinity;\n  };\n  const byEvent = {};\n  arr(inputs.regRecords).map(flat).forEach((r) => {\n    if (!r.event_id) return;\n    const cur = byEvent[r.event_id];\n    if (!cur || regMs(r.registered_at) < regMs(cur.registered_at)) byEvent[r.event_id] = r;\n  });\n  const myRegs = Object.keys(byEvent).map((k) => byEvent[k]);\n  const lines = [t('myreg.title')];\n  const keyboard = [];\n  if (myRegs.length === 0) {\n    lines.push(t('myreg.empty'));\n  } else {\n    myRegs.forEach((r) => {\n      const ev = eventsById[r.event_id] || {};\n      const title = ev.title || r.event_id;\n      const when = fmt(ev.starts_at || '');\n      let statusKey = 'myreg.status.registered';\n      if (String(r.status || '') === 'cancelled') statusKey = 'myreg.status.cancelled';\n      else if (r.checked_in_at) statusKey = 'myreg.status.checked_in';\n      lines.push(t('myreg.item', { title: title, when: when, status: t(statusKey) }));\n      if (String(r.status || '') === 'registered') {\n        const row = [];\n        if (miniappUrl) row.push({ text: t('reg.qr.button'), web_app: { url: miniappUrl + 'ticket.html?event_id=' + r.event_id } });\n        const startMs = parseIso(ev.starts_at || '');\n        if (isFinite(startMs) && nowMs < startMs) row.push({ text: t('myreg.btn.cancel'), callback_data: 'myreg:cancel:' + r.event_id });\n        if (row.length > 0) keyboard.push(row);\n      }\n    });\n  }\n  const out = { text: lines.join('\\n\\n') };\n  if (keyboard.length > 0) out.reply_markup = { inline_keyboard: keyboard };\n  return out;\n};",
                    "packageJson": "{}"
                  }
