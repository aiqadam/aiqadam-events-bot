          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const rows = arr(inputs.records).map(flat);\n  const ev = rows[0];\n  const telegramId = String(inputs.telegramId === undefined || inputs.telegramId === null ? '' : inputs.telegramId);\n  const eventId = String(inputs.eventId === undefined || inputs.eventId === null ? '' : inputs.eventId);\n\n  if (!ev) return { outcome: 'not_found' };\n  if (String(ev.owner_id || '') !== telegramId) return { outcome: 'not_owner' };\n\n  const orig = {\n    title: ev.title || '', description: ev.description || '', address: ev.address || '',\n    starts_at: ev.starts_at || '', ends_at: ev.ends_at || '', reg_deadline_at: ev.reg_deadline_at || '',\n    lat: ev.lat || '', lon: ev.lon || '', photo_file_id: ev.photo_file_id || '', status: ev.status || ''\n  };\n  const draft = Object.assign({ id: eventId }, orig, { _orig: orig });\n\n  return { outcome: 'ok', draft: JSON.stringify(draft), title: orig.title, now: new Date().toISOString() };\n};",
            "packageJson": "{}"
