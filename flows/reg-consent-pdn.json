                  "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n  // Эталон экранирования MarkdownV2 — catalog/snippets/markdown-v2.md.\n  const esc = (v) => String(v === undefined || v === null ? '' : v)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/([_*\\[\\]()~`>#+\\-=|{}.!])/g, '\\\\$1');\n  // Отказ объясняет причину и оставляет следующий шаг (ADR-0017 п. 6):\n  // регистрации нет, но дверь открыта — тот же deep link работает снова.\n  const text = esc(t('reg.consent_pdn.declined'));\n  return { text: text, now: new Date().toISOString() };\n};",
