                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] || key);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n\n  // Эталон экранирования MarkdownV2 — catalog/snippets/markdown-v2.md.\n  const esc = (v) => String(v === undefined || v === null ? '' : v)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/([_*\\[\\]()~`>#+\\-=|{}.!])/g, '\\\\$1');\n\n  // Q32: если сохранение согласия, чтение события или запись регистрации/сессии\n  // (continueOnFailure на step_4/step_6/step_5/step_9) упали — не показываем\n  // ложный успех. Одно понятное сообщение вместо тихой рассинхронизации\n  // карточки с реальным состоянием данных. esc() обязателен: format у\n  // step_8/step_10 — MarkdownV2, а «Что-то пошло не так» содержит дефис.\n  if (inputs.saveConsentError || inputs.readEventError || inputs.saveRegError || inputs.advanceSessionError) {\n    return { text: esc(t('common.err.generic')), replyMarkup: { inline_keyboard: [] }, title: '', now: new Date().toISOString() };\n  }\n\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const ev = arr(inputs.records).map(flat)[0] || {};\n\n  const TZ = 'Asia/Tashkent';\n  const dateFmt = new Intl.DateTimeFormat('ru-RU', { timeZone: TZ, day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n  const fmt = (iso) => {\n    if (!iso) return '';\n    const s = /[Zz]$/.test(iso) || /[+-][0-9]{2}:?[0-9]{2}$/.test(iso) ? iso : iso + 'Z';\n    const d = new Date(s);\n    return isNaN(d.getTime()) ? '' : dateFmt.format(d);\n  };\n\n  // Кульминация называется кульминацией (ADR-0017, дефект 3): подтверждение\n  // регистрации несёт дату и место, а не только факт.\n  const lines = [];\n  lines.push(esc(t('reg.done.header')));\n  const card = [];\n  if (ev.title) card.push('*' + esc(ev.title) + '*');\n  if (ev.starts_at) card.push('📅 ' + esc(fmt(ev.starts_at)));\n  if (ev.address) card.push('📍 ' + esc(ev.address));\n  if (card.length) lines.push(card.join('\\n'));\n  lines.push(esc(t('reg.consent_marketing.ask')));\n\n  const replyMarkup = {\n    inline_keyboard: [[\n      { text: t('reg.consent_marketing.btn_yes'), callback_data: 'reg:mkt:yes' },\n      { text: t('reg.consent_marketing.btn_no'), callback_data: 'reg:mkt:no' }\n    ]]\n  };\n\n  return { text: lines.join('\\n\\n'), replyMarkup: replyMarkup, title: ev.title || '', now: new Date().toISOString() };\n};",
                          "packageJson": "{}"
