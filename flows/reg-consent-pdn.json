          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const isYes = str(inputs.callbackData) === 'reg:pdn:yes';\n  let draft = {};\n  try { draft = JSON.parse(str(inputs.sessionDraft) || '{}'); } catch (e) { draft = {}; }\n  const eventId = str(draft.eventId);\n  const utm = str(draft.utm);\n  const telegramId = str(inputs.telegramId);\n  // ADR-0056: карточка не редактируется — cardMessageId больше не читается.\n  // draftJson остаётся: его кладёт в сессию step_9 (шаг await_marketing), а\n  // eventId из него нужен reg-consent-mkt, чтобы понять, слать билет или\n  // каталог Mini App. Пересобирается через JSON.stringify — кавычка в utm не\n  // ломает строку.\n  const draftJson = JSON.stringify({ eventId: eventId, utm: utm });\n  return {\n    isYes: isYes, eventId: eventId,\n    // W102: непустой sentinel для фильтра step_6 (пустой eq валит шаг).\n    eventIdOrNone: eventId !== '' ? eventId : '__none__',\n    utm: utm,\n    regId: eventId + '-' + telegramId,\n    draftJson: draftJson,\n    now: new Date().toISOString()\n  };\n};\n",
            "packageJson": "{}"
