                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n  const esc = (v) => String(v === undefined || v === null ? '' : v)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/([_*\\[\\]()~`>#+\\-=|{}.!])/g, '\\\\$1');\n\n  // Q32: если сохранение согласия, чтение события или запись регистрации/сессии\n  // (continueOnFailure на step_4/step_6/step_5/step_9) упали — не показываем\n  // ложный успех. esc() обязателен: format у send-шага — MarkdownV2.\n  if (inputs.saveConsentError || inputs.readEventError || inputs.saveRegError || inputs.advanceSessionError) {\n    return { text: esc(t('common.err.generic')), replyMarkup: { inline_keyboard: [] }, now: new Date().toISOString() };\n  }\n\n  // ADR-0056: финальное сообщение короткое — факты события показываются один\n  // раз, в первой карточке онбординга; здесь только финал и вопрос о рассылке.\n  const text = [esc(t('reg.done.header')), esc(t('reg.consent_marketing.ask'))].join('\\n\\n');\n  const replyMarkup = {\n    inline_keyboard: [[\n      { text: t('reg.consent_marketing.btn_yes'), callback_data: 'reg:mkt:yes' },\n      { text: t('reg.consent_marketing.btn_no'), callback_data: 'reg:mkt:no' }\n    ]]\n  };\n  return { text: text, replyMarkup: replyMarkup, now: new Date().toISOString() };\n};\n",
                          "packageJson": "{}"
