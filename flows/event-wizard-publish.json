                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] || key);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n\n  const scenario = String(inputs.scenario === undefined || inputs.scenario === null ? '' : inputs.scenario);\n  let draft = {};\n  try { draft = JSON.parse(String(inputs.draft === undefined || inputs.draft === null ? '{}' : inputs.draft)); } catch (e) { draft = {}; }\n  const telegramId = String(inputs.telegramId === undefined || inputs.telegramId === null ? '' : inputs.telegramId);\n  const botUsername = String(inputs.botUsername === undefined || inputs.botUsername === null ? '' : inputs.botUsername);\n\n  const isEdit = scenario === 'event_edit';\n  let id = String(draft.id || '');\n  if (!isEdit || !id) {\n    // 12 символов, алфавит [A-Za-z0-9_] — должно проходить SLUG в fn-parse-start\n    // (^[A-Za-z0-9_]{1,12}$). Без собственного префикса 'e': 'e' — это kind\n    // диплинка/QR-payload (?start=e<id>), а не часть самого id.\n    id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  const now = new Date().toISOString();\n\n  const orig = draft._orig || {};\n  const fieldKeys = ['title', 'address', 'starts_at', 'ends_at', 'reg_deadline_at'];\n  const labelKeys = { title: 'field.title', address: 'field.address', starts_at: 'field.starts_at', ends_at: 'field.ends_at', reg_deadline_at: 'field.reg_deadline_at' };\n  const TZ = 'Asia/Tashkent';\n  const fmt = new Intl.DateTimeFormat('ru-RU', { timeZone: TZ, day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n  const isDateField = (f) => f === 'starts_at' || f === 'ends_at' || f === 'reg_deadline_at';\n  const disp = (f, v) => {\n    if (!v) return '—';\n    if (isDateField(f)) { const d = new Date(v); return isNaN(d.getTime()) ? v : fmt.format(d); }\n    return String(v);\n  };\n\n  const changes = [];\n  if (isEdit) {\n    fieldKeys.forEach((f) => {\n      const before = String(orig[f] || '');\n      const after = String(draft[f] || '');\n      if (before !== after) changes.push(t(labelKeys[f]) + ': ' + disp(f, before) + ' → ' + disp(f, after));\n    });\n    const beforeLat = String(orig.lat || ''); const beforeLon = String(orig.lon || '');\n    const afterLat = String(draft.lat || ''); const afterLon = String(draft.lon || '');\n    if (beforeLat !== afterLat || beforeLon !== afterLon) {\n      const showGeo = (lat, lon) => (lat && lon) ? (lat + ', ' + lon) : '—';\n      changes.push(t('field.geo') + ': ' + showGeo(beforeLat, beforeLon) + ' → ' + showGeo(afterLat, afterLon));\n    }\n  }\n  const hasChanges = changes.length > 0;\n\n  const registrationUrl = botUsername ? ('https://t.me/' + botUsername + '?start=e' + id) : '';\n\n  const ownerConfirmText = isEdit\n    ? (hasChanges ? t('wizard.publish.updated_notified') : t('wizard.publish.updated_no_changes'))\n    : t('wizard.published', { url: registrationUrl });\n\n  const changeSummaryText = t('wizard.publish.change_summary', { title: String(draft.title || ''), changes: changes.join('\\n') });\n\n  return {\n    id: id,\n    title: String(draft.title || ''), description: String(draft.description || ''),\n    address: String(draft.address || ''), lat: String(draft.lat || ''), lon: String(draft.lon || ''),\n    startsAt: String(draft.starts_at || ''), endsAt: String(draft.ends_at || ''),\n    regDeadlineAt: String(draft.reg_deadline_at || ''), photoFileId: String(draft.photo_file_id || ''),\n    publishedAt: isEdit ? '' : now,\n    ownerId: telegramId,\n    registrationUrl: registrationUrl,\n    hasChanges: hasChanges, changeSummaryText: changeSummaryText, ownerConfirmText: ownerConfirmText,\n    now: now\n  };\n};",
                  "packageJson": "{}"
                }
