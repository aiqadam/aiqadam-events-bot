              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const str = (v) => String(v === undefined || v === null ? '' : v).trim();\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = { __recordId: String(rec && rec.id ? rec.id : '') };\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const parseIso = (s) => {\n    if (!s) return NaN;\n    return Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  };\n\n  const eventId = str(inputs.eventId);\n  const telegramId = str(inputs.telegramId);\n  const tokenHash = str(inputs.tokenHash);\n  const nowIso = new Date().toISOString();\n  const nowMs = Date.now();\n  // usedText — на случай, если invite будет отмечен использованным другим\n  // (конкурентным) прогоном между этим чтением и записью claim'а (step_7,\n  // only_if): текст нужен заранее, чтобы on-failure ветка не набирала его\n  // литералом в PIECE-шаге (ADR-0014).\n  const usedText = t('staff.accept.used');\n\n  const invite = arr(inputs.inviteRows).map(flat).filter((r) => str(r.token_hash) === tokenHash)[0] || null;\n  const ev = arr(inputs.eventRows).map(flat).filter((r) => str(r.id) === eventId)[0] || null;\n\n  const notOk = (outcome, key) => ({\n    outcome: outcome, text: t(key), title: '', usedText: usedText,\n    eventId: eventId, inviteRecordId: '-', grantedBy: '', nowIso: nowIso\n  });\n\n  // Дефолт fail-closed: нет строки, событие не найдено или eventId в ссылке\n  // не совпал с event_id инвайта (подмена ссылки при том же токене) — invalid.\n  if (!invite || str(invite.event_id) !== eventId || !ev) return notOk('invalid', 'staff.accept.invalid');\n  if (str(invite.used_at) !== '') return notOk('used', 'staff.accept.used');\n  const exp = parseIso(invite.expires_at);\n  if (!isFinite(exp) || exp <= nowMs) return notOk('expired', 'staff.accept.expired');\n\n  const title = str(ev.title);\n  return {\n    outcome: 'ok',\n    text: t('staff.accept.ok', { title: title }),\n    title: title, usedText: usedText,\n    eventId: eventId,\n    inviteRecordId: str(invite.__recordId) || '-',\n    grantedBy: str(invite.created_by),\n    nowIso: nowIso\n  };\n};",
                "packageJson": "{}"
              }
