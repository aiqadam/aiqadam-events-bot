                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key, vars) => {\n    let s = String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n    if (vars) Object.keys(vars).forEach((k) => { s = s.split('{' + k + '}').join(String(vars[k])); });\n    return s;\n  };\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = str(c.value);\n      else out[fid] = str(c);\n    });\n    return out;\n  };\n  const parseIso = (s) => Date.parse(/[Zz]$/.test(s) || /[+-][0-9]{2}:?[0-9]{2}$/.test(s) ? s : s + 'Z');\n  const now = Date.now();\n  const nowIso = new Date(now).toISOString();\n  const active = inputs.sessionActive === true || str(inputs.sessionActive) === 'true';\n  const quizId = str(inputs.quizId);\n  const idx = Number(inputs.idx) || 0;\n  const count = Number(inputs.count) || 0;\n  const shownAt = Number(inputs.shownAt) || 0;\n  const firstName = str(inputs.firstName).trim();\n  const lastName = str(inputs.lastName).trim();\n  const displayName = (firstName + ' ' + lastName).trim();\n  const quizzes = arr(inputs.quiz).map(flat).filter((q) => str(q.id) === quizId);\n  const questions = arr(inputs.questions).map(flat)\n    .filter((q) => str(q.quiz_id) === quizId)\n    .sort((a, b) => Number(a.idx) - Number(b.idx));\n  const out = {\n    outcome: 'ignore', text: '',\n    answerQuizId: quizId, answerTgId: str(inputs.telegramId), answerIdx: idx,\n    answerText: '', answeredAt: nowIso, elapsedMs: 0, late: 'false',\n    displayName: displayName, nextDraft: '', last: false\n  };\n  if (!active || idx < 1 || count === 0 || idx > count) return out;\n  const qz = quizzes[0] || null;\n  let windowOk = false;\n  if (qz) {\n    const st = parseIso(str(qz.starts_at));\n    const en = parseIso(str(qz.ends_at));\n    windowOk = isFinite(st) && isFinite(en) && now >= st && now <= en;\n  }\n  if (!windowOk) { out.outcome = 'reply'; out.text = t('quiz.closed'); return out; }\n  const answer = str(inputs.messageText).trim().slice(0, 500);\n  const elapsed = shownAt > 0 && now >= shownAt ? now - shownAt : 0;\n  const qzCount = questions.length || count;\n  const nextIdx = idx + 1;\n  out.answerText = answer;\n  out.elapsedMs = elapsed;\n  out.late = elapsed > 15000 ? 'true' : 'false';\n  if (nextIdx <= qzCount) {\n    const nq = questions[nextIdx - 1] ? str(questions[nextIdx - 1].text) : '';\n    out.outcome = 'next';\n    out.text = t('quiz.q_header', { n: nextIdx, total: qzCount }) + '\\n\\n' + nq + '\\n\\n' + t('quiz.q_hint');\n    out.nextDraft = JSON.stringify({ quizId: quizId, idx: nextIdx, count: qzCount, shownAt: now });\n  } else {\n    out.outcome = 'finish';\n    out.text = t('quiz.done');\n  }\n  return out;\n};",
