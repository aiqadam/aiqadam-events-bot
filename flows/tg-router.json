        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const upd = inputs.update || {};\n  const updateId = upd.update_id;\n  const msg = upd.message;\n  const cbq = upd.callback_query;\n\n  const src = cbq ? cbq : msg;\n  const from = (src && src.from) || {};\n  const isBot = from.is_bot === true;\n\n  const chat = cbq ? (cbq.message && cbq.message.chat) : (msg && msg.chat);\n  const isPrivate = !!(chat && chat.type === 'private');\n\n  const text = msg && typeof msg.text === 'string' ? msg.text : '';\n  let command = '';\n  let startPayload = '';\n  let commandArgs = '';\n  if (text.charAt(0) === '/') {\n    const sp = text.indexOf(' ');\n    const cmdRaw = sp < 0 ? text.slice(1) : text.slice(1, sp);\n    command = cmdRaw.split('@')[0];\n    commandArgs = sp < 0 ? '' : text.slice(sp + 1).trim();\n    if (command === 'start') startPayload = commandArgs;\n  }\n\n  const contact = msg && msg.contact;\n  const contactPhone = contact ? String(contact.phone_number || '') : '';\n  const contactIsOwn = !!(contact && String(contact.user_id || '') === String(from.id || ''));\n\n  const photos = msg && Array.isArray(msg.photo) ? msg.photo : null;\n  const hasPhoto = !!(photos && photos.length > 0);\n  const photoFileId = hasPhoto ? String(photos[photos.length - 1].file_id || '') : '';\n\n  const location = msg && msg.location;\n  const hasLocation = !!(location && typeof location.latitude === 'number' && typeof location.longitude === 'number');\n  const locationLat = hasLocation ? String(location.latitude) : '';\n  const locationLon = hasLocation ? String(location.longitude) : '';\n\n  const callbackData = cbq ? String(cbq.data || '') : '';\n  const callbackQueryId = cbq ? String(cbq.id || '') : '';\n\n  // messageId — входящее сообщение гостя. Нужен, чтобы убрать из ленты\n  // ответ на транзиентный вопрос (ADR-0017: в ленте остаются карточка и билет).\n  const messageId = msg && msg.message_id !== undefined && msg.message_id !== null ? Number(msg.message_id) : 0;\n\n  const tgId = String(from.id === undefined || from.id === null ? '' : from.id);\n  const chatId = String(chat && chat.id !== undefined && chat.id !== null ? chat.id : tgId);\n\n  const dedupKey = 'upd:' + String(updateId === undefined || updateId === null ? '' : updateId);\n  const bad = (updateId === undefined || updateId === null) || tgId === '';\n\n  return {\n    ok: !bad,\n    updateId: updateId, dedupKey: dedupKey,\n    tgId: tgId, chatId: chatId, messageId: messageId,\n    text: text, command: command, startPayload: startPayload, commandArgs: commandArgs,\n    callbackData: callbackData, callbackQueryId: callbackQueryId,\n    contactPhone: contactPhone, contactIsOwn: contactIsOwn,\n    hasContact: !!contact,\n    hasPhoto: hasPhoto, photoFileId: photoFileId,\n    hasLocation: hasLocation, locationLat: locationLat, locationLon: locationLon,\n    isBot: isBot, isPrivate: isPrivate,\n    firstName: String(from.first_name || ''), lastName: String(from.last_name || ''),\n    username: String(from.username || ''), languageCode: String(from.language_code || ''),\n    now: new Date().toISOString()\n  };\n};",
