                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n\n  const staffRows = arr(inputs.staffRows);\n  if (staffRows.length === 0) {\n    return { httpStatus: 403, ok: false, registered: 0, checked_in: 0, status: 'forbidden', text: t('checkin.forbidden') };\n  }\n\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') {\n        out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n      }\n    });\n    return out;\n  };\n\n  const rows = arr(inputs.regRows).map(flat);\n  let registered = 0;\n  let checkedIn = 0;\n  rows.forEach((r) => {\n    if (String(r.status || '') !== 'registered') return;\n    registered += 1;\n    if (String(r.checked_in_at || '') !== '') checkedIn += 1;\n  });\n\n  return { httpStatus: 200, ok: true, registered: registered, checked_in: checkedIn, status: 'ok', text: '' };\n};",
