              "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const arr = (src) => Array.isArray(src) ? src : (src && Array.isArray(src.records) ? src.records : []);\n  const flat = (rec) => {\n    const out = {};\n    const cells = (rec && rec.cells) || {};\n    Object.keys(cells).forEach((fid) => {\n      const c = cells[fid];\n      if (c && typeof c === 'object' && typeof c.fieldName === 'string') out[c.fieldName] = c.value === undefined || c.value === null ? '' : String(c.value);\n    });\n    return out;\n  };\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (k) => String(texts[k] || k);\n  const rows = arr(inputs.userRecords).map(flat)\n    .filter((r) => str(r.telegram_id) === str(inputs.telegramId));\n  const row = rows[0];\n  const now = new Date().toISOString();\n  if (!row || str(row.consent_marketing) !== 'true')\n    return { already: true, text: t('unsub.already'), now: now };\n  return { already: false, text: t('unsub.done'), now: now };\n};",
