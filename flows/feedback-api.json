                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  // W45 (Q53): доступ к форме отзыва — только по факту участия (регистрация\n  // с чекином) на КОНКРЕТНЫЙ eventId; чужой eventId, где вызывающий не был,\n  // отвечает тем же 'forbidden', что и полное отсутствие регистрации — это\n  // и есть защита от IDOR (fn-find-registration уже фильтрует по паре\n  // event_id+telegram_id, catalog/flows/fn-find-registration.md).\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n\n  const hmac = inputs.hmac || {};\n  const telegramId = str(hmac.telegramId);\n\n  const reg = inputs.reg || {};\n  const found = reg.found === true || reg.found === 'true';\n  const checkedIn = reg.checkedIn === true || reg.checkedIn === 'true';\n  const attended = found && checkedIn;\n\n  const eventId = str(inputs.eventId);\n  const action = str(inputs.action) === 'submit' ? 'submit' : 'load';\n\n  const base = {\n    ok: false, error: '', text: '', httpStatus: 200, fields: {},\n    eventId: eventId, telegramId: telegramId,\n    rating: 0, comment: '', submittedAt: ''\n  };\n\n  if (!telegramId || !eventId || !attended) {\n    return Object.assign({}, base, { outcome: 'forbidden', httpStatus: 403, error: 'forbidden', text: t('feedback.err.forbidden') });\n  }\n\n  if (action === 'load') {\n    return Object.assign({}, base, { outcome: 'load' });\n  }\n\n  // submit — оценка обязательна 1..5 (целое); комментарий необязателен, обрезка 2000.\n  const ratingNum = Math.trunc(Number(inputs.rating));\n  if (!Number.isFinite(ratingNum) || ratingNum < 1 || ratingNum > 5) {\n    return Object.assign({}, base, { outcome: 'validation', httpStatus: 422, error: 'validation', text: t('feedback.err.rating'), fields: { rating: 'feedback.err.rating' } });\n  }\n  const comment = str(inputs.comment).slice(0, 2000);\n  return Object.assign({}, base, {\n    outcome: 'submit', rating: ratingNum, comment: comment,\n    submittedAt: new Date().toISOString(), ok: true, text: t('feedback.thanks')\n  });\n};",
