              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  // W123: валидация сообщения о проблеме. Staff-гейта нет — пожаловаться\n  // может любой, у кого валидный initData. text обязателен (≤2000), kind —\n  // из объявленного набора; eventId — только контекст, не гейт прав, поэтому\n  // хранится лишь в форме нашего slug (иначе пусто).\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] === undefined || texts[key] === null ? key : texts[key]);\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n\n  const hmac = inputs.hmac || {};\n  const telegramId = str(hmac.telegramId);\n\n  const base = {\n    ok: false, error: '', text: '', httpStatus: 200, fields: {},\n    telegramId: telegramId, kind: '', reportText: '', route: '',\n    eventId: '', appVersion: '', context: '', status: 'new', createdAt: ''\n  };\n\n  if (!/^\\d{1,20}$/.test(telegramId)) {\n    return Object.assign({}, base, { outcome: 'invalid', httpStatus: 401, error: 'invalid_init_data', text: t('report.error.init') });\n  }\n\n  const allowed = { broken: true, text: true, message: true, other: true };\n  const kind = str(inputs.kind);\n  if (!allowed[kind]) {\n    return Object.assign({}, base, { outcome: 'validation', httpStatus: 422, error: 'validation', text: t('report.error.kind'), fields: { kind: 'report.error.kind' } });\n  }\n\n  const reportText = str(inputs.text).trim();\n  if (!reportText) {\n    return Object.assign({}, base, { outcome: 'validation', httpStatus: 422, error: 'validation', text: t('report.error.text'), fields: { text: 'report.error.text' } });\n  }\n  if (reportText.length > 2000) {\n    return Object.assign({}, base, { outcome: 'validation', httpStatus: 422, error: 'validation', text: t('report.error.long'), fields: { text: 'report.error.long' } });\n  }\n\n  const rawEvent = str(inputs.eventId);\n  const eventId = /^[A-Za-z0-9_]{1,64}$/.test(rawEvent) ? rawEvent : '';\n  const route = str(inputs.route).slice(0, 200);\n  const appVersion = str(inputs.appVersion).slice(0, 64);\n  const context = str(inputs.context).slice(0, 2000);\n\n  return Object.assign({}, base, {\n    outcome: 'ok', ok: true, kind: kind, reportText: reportText,\n    route: route, eventId: eventId, appVersion: appVersion,\n    context: context, createdAt: new Date().toISOString(), text: t('report.ok')\n  });\n};",
                "packageJson": "{}"
              }
