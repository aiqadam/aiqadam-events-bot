          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const isYes = str(inputs.callbackData) === 'reg:mkt:yes';\n  let draft = {};\n  try { draft = JSON.parse(str(inputs.sessionDraft) || '{}'); } catch (e) { draft = {}; }\n  const eventId = str(draft.eventId);\n  const utm = str(draft.utm);\n  const cardMessageId = Number(draft.cardMessageId);\n  const cardId = isFinite(cardMessageId) && cardMessageId > 0 ? cardMessageId : 0;\n  return {\n    isYes: isYes,\n    consentValue: isYes ? 'true' : 'false',\n    eventId: eventId, utm: utm, cardMessageId: cardId,\n    // Черновик на следующий шаг: promptMessageId допишется после отправки\n    // вопроса о телефоне — его message_id до отправки неизвестен.\n    draftJson: JSON.stringify({ eventId: eventId, utm: utm, cardMessageId: cardId, promptMessageId: 0 }),\n    now: new Date().toISOString()\n  };\n};",
