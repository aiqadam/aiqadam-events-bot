                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n  // Эталон экранирования MarkdownV2 — catalog/snippets/markdown-v2.md.\n  const esc = (v) => String(v === undefined || v === null ? '' : v)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/([_*\\[\\]()~`>#+\\-=|{}.!])/g, '\\\\$1');\n\n  const isYes = inputs.isYes === true || inputs.isYes === 'true';\n  const lines = [\n    esc(t('reg.done.header')),\n    esc(t(isYes ? 'reg.consent_marketing.saved_yes' : 'reg.consent_marketing.saved_no')),\n    esc(t('reg.phone.ask_card'))\n  ];\n  return { text: lines.join('\\n\\n'), now: new Date().toISOString() };\n};",
