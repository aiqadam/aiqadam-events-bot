                            "sourceCode": {
                              "code": "export const code = async (inputs) => {\n  const str = (v) => String(v === undefined || v === null ? '' : v);\n  const num = (v) => { const n = Number(v); return isFinite(n) && n > 0 ? n : 0; };\n  // Если карточку не удалось отредактировать, актуальной становится та,\n  // что ушла фолбэком. Шаг фолбэка выполняется не всегда, поэтому его\n  // выход коалесцируется, а не читается напрямую.\n  const cardMessageId = num(inputs.fallbackCardId) || num(inputs.cardMessageId);\n  return {\n    draftJson: JSON.stringify({\n      eventId: str(inputs.eventId),\n      utm: str(inputs.utm),\n      cardMessageId: cardMessageId,\n      promptMessageId: num(inputs.promptMessageId)\n    }),\n    now: new Date().toISOString()\n  };\n};",
