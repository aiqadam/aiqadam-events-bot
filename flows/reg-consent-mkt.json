                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const texts = (inputs.texts && typeof inputs.texts === 'object') ? inputs.texts : {};\n  const t = (key) => String(texts[key] || key);\n  // Здесь format=None (текст без разметки), поэтому экранирование не нужно:\n  // сообщение транзиентное и состоит только из наших строк.\n  // Телефон берётся ТОЛЬКО через request_contact (DAT-2) — а это reply-клавиатура,\n  // которую edit_message_text не принимает («inline keyboard expected»).\n  // Поэтому вопрос уходит отдельным сообщением и потом удаляется.\n  const replyMarkup = {\n    keyboard: [\n      [{ text: t('reg.phone.btn_share'), request_contact: true }],\n      [{ text: t('reg.phone.btn_skip') }]\n    ],\n    resize_keyboard: true,\n    one_time_keyboard: true\n  };\n  return { text: t('reg.phone.ask'), replyMarkup: replyMarkup, now: new Date().toISOString() };\n};",
